{
  "name": "miniheadquarter-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --outdir=dist --format=esm --out-extension:.js=.mjs",
    "dev": "tsx watch src/local.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "node-html-parser": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.24",
    "eslint": "^9",
    "jiti": "^2.6.1",
    "tsx": "^4",
    "typescript": "^5.7",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
